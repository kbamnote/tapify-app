{
  "expo": {
    "name": "Tapify",
    "slug": "tapify",
    "version": "1.1.5",
    "scheme": "tapifapp",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/tapify-logo-green.png",
      "resizeMode": "native",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kbamnote.tapifapp",
      "icon": "./assets/app-icon.png",
      "googleServicesFile": "./google-services.json",
      "versionCode": 37,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "./plugins/withMainApplication",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#153e3f",
          "defaultChannel": "tapify_alerts",
          "sounds": [
            "./assets/notification_sound.mpeg"
          ]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "da1e4675-9f10-4b35-944c-6e4d8067e62d"
      }
    }
  }
}
