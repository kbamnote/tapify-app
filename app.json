{
  "expo": {
    "name": "Tapify",
    "slug": "tapif-app",
    "owner": "kbamnote",
    "version": "1.1.12",
    "scheme": "tapifapp",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kbamnote.tapifapp",
      "icon": "./assets/app-icon.png",
      "googleServicesFile": "./google-services.json",
      "versionCode": 56,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "./plugins/withMainApplication",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#153e3f",
          "defaultChannel": "tapify_alerts",
          "sounds": [
            "./assets/notification_sound.mpeg"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tapify to access your photos so you can upload images to your website."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c8ffb44e-62c6-434b-8109-ec5c66568151"
      }
    }
  }
}
