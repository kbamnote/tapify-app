{
  "expo": {
    "name": "Tapify",
    "slug": "tapif-app",
    "version": "1.1.5",
    "scheme": "tapifapp",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/tapify-logo-green.png",
      "resizeMode": "native",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kbamnote.tapifapp",
      "icon": "./assets/app-icon.png",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c8ffb44e-62c6-434b-8109-ec5c66568151"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#ffffff"
        }
      ]
    ]
  }
}
